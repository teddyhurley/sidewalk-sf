# Optional. Demo needs no credentials. Use a dedicated public (pk.) Mapbox token.
# Enable Geocoding v6, Directions and Mapbox GL; review billing and URL restrictions.
MAPBOX_PUBLIC_TOKEN=
# Optional distinct public-scope token for Node requests (no browser URL restriction).
# Defaults to MAPBOX_PUBLIC_TOKEN for local verification if omitted.
MAPBOX_SERVER_TOKEN=
# Recommended for the read-only source audit and evidence refresh.
SOCRATA_APP_TOKEN=
# Keep disabled until data:refresh and the local validation gates pass.
LIVE_EVIDENCE_PREVIEW=0
PORT=4173
HOST=127.0.0.1
# Optional interpreter for boundary refresh only; needs Shapely 2.
# BOUNDARY_PYTHON=/absolute/path/to/python3

# Hosted protected preview (Render Blueprint supplies these; local defaults stay off).
# PREVIEW_AUTH_REQUIRED=1
# PREVIEW_USERNAME=sidewalk
# PREVIEW_PASSWORD=use-a-random-value-of-at-least-24-characters
# DATA_DIR=/var/data/sidewalk
# AUTO_REFRESH=1
# TRUST_PROXY_HOPS=1
# DAILY_PROVIDER_REQUEST_BUDGET=1000
# MINUTE_PROVIDER_REQUEST_BUDGET=120
# COLLISION_FROM=2024-07-01
# COLLISION_THROUGH=2026-06-30
